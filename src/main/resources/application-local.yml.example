# =============================================================================
# Local development configuration (TEMPLATE)
# =============================================================================
#
# This file is NOT used by the application directly.
# Copy it to application-local.yml and fill in your real values:
#
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
#
# application-local.yml is gitignored — never commit real passwords.
#
# application.yml imports it automatically:
#   spring.config.import: optional:classpath:application-local.yml
#
# =============================================================================

spring:
  datasource:
    username: root
    password: YOUR_MYSQL_PASSWORD

identity:
  mail:
    # true  = use SmtpNotificationSender (requires SMTP config in DB via admin API)
    # false = use LoggingNotificationSender (tokens printed in server logs only)
    enabled: true

  smtp:
    # Used to encrypt/decrypt SMTP passwords stored in email_smtp_config table.
    # Use the SAME values across restarts or you cannot decrypt existing passwords.
    encryption-password: ${SMTP_ENCRYPTION_PASSWORD:local-dev-encryption-key-change-me}
    encryption-salt: ${SMTP_ENCRYPTION_SALT:ab12cd34ef567890}

# -----------------------------------------------------------------------------
# SMTP email credentials are NOT configured here anymore.
# After first startup, configure via admin API:
#
#   PUT /api/v1/admin/email/smtp-config
#   Authorization: Bearer <ADMIN_JWT>
#
#   {
#     "host": "smtp.gmail.com",
#     "port": 587,
#     "username": "your-email@gmail.com",
#     "password": "your-gmail-app-password",
#     "authEnabled": true,
#     "tlsEnabled": true,
#     "fromEmail": "your-email@gmail.com"
#   }
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Fulfillment execution (worker) and purchase adapters are SEPARATE switches.
# Enabling the worker without any SupplierPurchasePort bean fails fast at startup.
# fake-purchase and likecard-purchase must not both be enabled (ambiguous bean).
# Do not enable fake-purchase against real paid traffic.
# Do not enable likecard-purchase unless intentionally calling LikeCard /buy.
# -----------------------------------------------------------------------------
takarub:
  commerce:
    fulfillment-execution:
      enabled: false
      fixed-delay-ms: 5000
      initial-delay-ms: 15000
  supplier:
    fake-purchase:
      enabled: false
    likecard-purchase:
      enabled: false
