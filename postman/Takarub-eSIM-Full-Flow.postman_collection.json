{
  "info": {
    "name": "Takarub eSIM Full Flow",
    "_postman_id": "7c2a0c8e-4d1b-4f2a-9c11-takarub-esim-flow",
    "description": "Local happy-path: register → verify → login → catalog → cart → checkout → fake payment success → my orders / eSIM.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "email", "value": "qusai.flow@example.com" },
    { "key": "password", "value": "Password123" },
    { "key": "accessToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "verificationToken", "value": "" },
    { "key": "packageId", "value": "864215a4-cdc8-441e-9ed4-fcbff14f16a8" },
    { "key": "orderId", "value": "" },
    { "key": "paymentAttemptId", "value": "" },
    { "key": "idempotencyKey", "value": "" }
  ],
  "item": [
    {
      "name": "01 Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('userId', body.userId);",
              "  console.log('Registered userId=' + body.userId + ' status=' + body.status);",
              "  console.log('Next: take verification id from DB and put it in verificationToken, then run 02 Verify Email.');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "02 Verify Email",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/verify-email"
      }
    },
    {
      "name": "03 Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('accessToken', body.accessToken);",
              "  pm.collectionVariables.set('userId', body.userId);",
              "  pm.collectionVariables.set('sessionId', body.sessionId);",
              "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"deviceName\": \"Postman\",\n  \"deviceType\": \"WEB\",\n  \"ipAddress\": \"127.0.0.1\",\n  \"userAgent\": \"PostmanRuntime\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "04 List Countries",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/catalog/countries"
      }
    },
    {
      "name": "05 Search Packages JO",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  if (body.content && body.content.length > 0) {",
              "    pm.collectionVariables.set('packageId', body.content[0].id);",
              "  }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/catalog/packages/search?countryIso=JO&size=5"
      }
    },
    {
      "name": "06 Package Details",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/catalog/packages/{{packageId}}"
      }
    },
    {
      "name": "07 Add To Cart",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"packageId\": \"{{packageId}}\",\n  \"quantity\": 1\n}"
        },
        "url": "{{baseUrl}}/api/v1/cart/items"
      }
    },
    {
      "name": "08 Get Cart",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/cart"
      }
    },
    {
      "name": "09 Checkout And Start Payment",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('idempotencyKey')) {",
              "  pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}').substring(0, 36));",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('orderId', body.orderId);",
              "  pm.collectionVariables.set('paymentAttemptId', body.paymentAttemptId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"packageId\": \"{{packageId}}\",\n  \"quantity\": 1\n}"
        },
        "url": "{{baseUrl}}/api/v1/checkout"
      }
    },
    {
      "name": "10 Confirm Payment Success (dev)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"paymentAttemptId\": \"{{paymentAttemptId}}\",\n  \"verificationReference\": \"success\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/dev/payments/notifications"
      }
    },
    {
      "name": "11 My Orders",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/orders"
      }
    },
    {
      "name": "12 Order Details",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/orders/{{orderId}}"
      }
    },
    {
      "name": "13 eSIM Activation (My Account)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/esim"
      }
    },
    {
      "name": "14 Admin Pricing (after ADMIN role + re-login)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/admin/pricing"
      }
    }
  ]
}
